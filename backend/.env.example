DEBUG=True
SECRET_KEY=change-me-use-long-random-string

# Dev rápido (sem Docker): descomente a linha abaixo e comente DB_* MySQL
# DB_ENGINE=django.db.backends.sqlite3

DB_ENGINE=django.db.backends.mysql
DB_NAME=skylog
DB_USER=skylog
DB_PASSWORD=skylog
DB_HOST=127.0.0.1
DB_PORT=3307

JWT_SECRET=change-me-same-as-secret-or-separate
JWT_EXPIRES_HOURS=24

FRONTEND_URL=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Cache em memória (segundos) — reduz carga na NASA Horizons / Open-Meteo e no SSE
HORIZONS_CACHE_TTL=900
WEATHER_FORECAST_CACHE_TTL=600
WEATHER_CURRENT_CACHE_TTL=60
